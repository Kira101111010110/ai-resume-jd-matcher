# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ที่มี key จริงเข้า git

# ต้องมีอย่างน้อย 1 ค่า ขึ้นอยู่กับว่าจะใช้ model_provider ไหนตอนเรียก /analyze
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# เปิด/ปิดการดึงสกิลจากกราฟิกในเรซูเม่ (skill bar / กราฟวงกลม % / ดาว rating / ไอคอน-โลโก้)
# ใช้ Gemini เสมอ (ต้องมี GEMINI_API_KEY) ไม่ว่า model_provider ที่เลือกไว้คือตัวไหน
# ปิดได้ด้วยการตั้งเป็น false — ถ้าปิด resume ที่มีกราฟิกสกิลจะไม่ถูกดึงสกิลนั้นมาเลย
VISUAL_SKILL_EXTRACTION=true

# โมเดล Gemini ที่ใช้อ่านกราฟิกสกิล — ไม่ตั้งก็ใช้ default เดียวกับ analyze_with_gemini
VISION_MODEL_NAME=gemini-3.6-flash
